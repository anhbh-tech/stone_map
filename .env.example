# Tuỳ chọn — mặc định chạy được hoàn toàn offline (provider mock, mailer outbox, thanh toán giả lập).
SITE_URL=http://localhost:3000
# Gen thật: đổi settings.ai.provider ở /admin/settings rồi điền key.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Chạy worker trong cùng process Next (dev). Production: WORKER_INLINE=0 và chạy `npm run worker`.
WORKER_INLINE=1
